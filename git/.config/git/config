	email = 32438065+mmilani1@users.noreply.github.com
	signingkey = Matheus Milani

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autosquash = true
	autostash = true
	updateRefs = true

[rerere]
	enabled = true
	autoupdate = true

[stash]
	showIncludeUntracked = true

[commit]
	gpgsign = true

[gpg]
	format = openpgp

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
